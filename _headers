/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; form-action https://docs.google.com; base-uri 'none'; frame-ancestors 'none'

/style.css
  Cache-Control: public, max-age=604800

/app.js
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=3600
